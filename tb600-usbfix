#!/bin/sh
# Run by udev (70-tb-stealth600.rules) as root.
# After power-up the transmitter enumerates high-speed, where its audio interfaces never answer
# (-110); once its HID interface is up, the first audio request makes it reboot into full-speed,
# where everything works (HID alone does not: it stays high-speed). The kernel probes audio first,
# so the reboot only came ~85 s later. While armed (from the transmitter's bootloader appearing until
# it is back at full speed, 20 s at most) new interfaces on that bus are held back and bound here:
# HID first, then audio.
#   arm <bootloader devpath> | iface <interface devpath> | disarm <busnum>
set -u
S=/sys/bus/usb

bind_dev() {  # authorize all held-back interfaces of a device first, so drivers can claim siblings, then probe
  for i in "$1"/*:*; do [ "$(cat "$i/authorized")" = 0 ] && echo 1 > "$i/authorized"; done
  for i in "$1"/*:*; do [ -e "$i/driver" ] || echo "${i##*/}" > $S/drivers_probe; done
}

disarm() {
  echo 1 > $S/devices/usb$1/interface_authorized_default
  for d in $S/devices/$1-*; do
    case ${d##*/} in *:*) ;; *) bind_dev "$d" ;; esac
  done
}

case $1 in
arm)
  bus=$(cat "/sys$2/busnum")
  echo 0 > $S/devices/usb$bus/interface_authorized_default
  systemd-run --no-block --collect --on-active=20 --timer-property=AccuracySec=100ms "$0" disarm "$bus" ;;
disarm)
  disarm "$2" ;;
iface)
  i=/sys$2; d=${i%/*}
  if [ "$(cat "$d/idVendor"):$(cat "$d/idProduct")" = 10f5:224c ]; then
    if [ "$(cat "$d/speed")" = 480 ]; then
      if [ "${i##*.}" = 3 ]; then
        echo 1 > "$i/authorized" && echo "${i##*/}" > $S/drivers_probe
        disarm "$(cat "$d/busnum")"  # HID is up: the first audio request now makes it reboot into full-speed
      fi
    else
      disarm "$(cat "$d/busnum")"
    fi
  else
    bind_dev "$d"
  fi ;;
esac
